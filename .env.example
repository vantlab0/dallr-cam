# Server-side only. Never prefix this with VITE_ — that would expose it to the frontend.
# The Vite dev server uses it to mint short-lived Decart client tokens at
# POST /api/realtime-token. The key is never included in the client bundle.
DECART_API_KEY=

# Optional: use a hosted token service instead of the local Vite endpoint.
# The endpoint must accept POST and return JSON shaped like:
#   { "apiKey": "<short-lived Decart client token>" }
# This URL is public configuration, not a secret.
VITE_DECART_TOKEN_ENDPOINT=
