# Server-side only. Never prefix this with VITE_ — that would expose it to the frontend.
DECART_API_KEY=

# Optional: use a hosted token service instead of the local Vite endpoint.
VITE_DECART_TOKEN_ENDPOINT=

# Paystack Payment Gateway
VITE_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Supabase Auth & User Storage
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
VITE_SUPABASE_JWKS_URL=
