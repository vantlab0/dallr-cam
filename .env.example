# Server-side only. Never prefix this with VITE_ — that would expose it to the frontend.
# The Vite dev server uses it to mint short-lived Decart client tokens at
# POST /api/realtime-token. The key is never included in the client bundle.
DECART_API_KEY=

# Public endpoint for minting short-lived Decart client tokens in production/packaged builds.
# The endpoint must accept POST, support CORS, and return JSON shaped like:
#   { "apiKey": "<short-lived Decart client token>" }
# Example: https://dallr-token-service.example.com/api/realtime-token
VITE_DECART_TOKEN_ENDPOINT=

# Supabase Production Auth Credentials
# When set, the app enforces real Supabase authentication (no demo fallbacks).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Paystack Production Payments Key
# When set, the app uses real Paystack checkout (no demo fallbacks).
VITE_PAYSTACK_PUBLIC_KEY=
