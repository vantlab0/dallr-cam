{
  "name": "dallr-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Dallr Studio — a desktop workspace for live Decart Lucy 2.5 camera transformation.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "build:desktop": "pnpm build && tauri build",
    "build:win": "pnpm build && tauri build",
    "build:mac": "pnpm build && tauri build --target universal-apple-darwin",
    "vcam:install": "cmd.exe /c scripts\\install-obs-virtualcam.bat",
    "server": "node --experimental-strip-types server/index.ts",
    "server:dev": "node --experimental-strip-types --watch server/index.ts"
  },
  "dependencies": {
    "@decartai/sdk": "0.2.12",
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource/instrument-serif": "^5.2.5",
    "@supabase/supabase-js": "^2.118.0",
    "@tauri-apps/api": "^2.5.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.15.0",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@tauri-apps/cli": "^2.5.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.27.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.1.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.33.0",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  },
  "packageManager": "pnpm@12.5.1"
}
